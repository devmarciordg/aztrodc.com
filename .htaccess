Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Evita acesso público a arquivos de configuração e dependências.
<FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.[^.]*)$">
  Require all denied
</FilesMatch>
